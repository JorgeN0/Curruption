# Curruption Plymouth theme.
# Generated by scripts/build.py from theme/modules/ and config/theme.conf.
# Do not edit this file directly; edit the modules and rebuild.

# ==== 00-config.script ====
# Generated by scripts/build.py from config/theme.conf.
# Do not edit this file directly.
Config.animation_duration = 10.0;
Config.animation_speed = 1.0;
Config.refresh_rate = 30;
Config.gore_enabled = 1;
Config.jaw_open_distance = 42;
Config.blood_overlay_opacity = 1.0;
Config.dangling_eye_enabled = 0;
Config.dangling_eye_sway = 0.035;
Config.dangling_eye_speed = 0.8;
Config.big_brother_eye_enabled = 1;
Config.eye_duration = 0.30;
Config.eye_color_r = 1.0;
Config.eye_color_g = 0.0;
Config.eye_color_b = 0.2;
Config.smoke_density = 0.14;
Config.glitch_intensity = 0.80;
Config.film_grain = 0.12;
Config.vignette_opacity = 0.62;
Config.hud_enabled = 1;
Config.random_seed = 31991;

# ==== 10-core.script ====
# Shared clock, geometry, layout anchors, and deterministic helpers.
#
# Nothing here allocates images. Every system preloads and scales its own
# artwork once at load time and only moves sprites inside the refresh
# callback, which is what keeps the sequence cheap enough for early boot.
#
# Plymouth's script language has no automatic function-local scoping: a bare
# `x = 1;` assigned inside a `fun` is a write to the GLOBAL `x`, shared by
# every function in the compiled script, unless the function first declares
# `local.x;`. build.py concatenates all ten modules into one script, so a
# temp variable named e.g. `level` in one module's Update() is the same
# storage as a same-named `level` temp in every other module's Update().
# Every function below that assigns a bare scratch variable declares it
# `local.` first, matching the pattern used by Plymouth's own themes.

Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

screen.w = Window.GetWidth();
screen.h = Window.GetHeight();
screen.cx = screen.w / 2;
screen.cy = screen.h / 2;

# One uniform scale against the 1920x1080 reference layout. The composition is
# never stretched, so portrait and ultrawide panels letterbox instead of
# distorting the skull.
scale = screen.h / 1080;
if (screen.w / 1920 < scale) scale = screen.w / 1920;
if (scale < 0.30) scale = 0.30;

# HUD anchors are screen fractions rather than offsets from a fixed 1920x1080
# box, so telemetry stays on screen at 1366x768 and at 2560x1440 alike.
layout.left = screen.w * 0.055;
layout.right = screen.w - screen.w * 0.055;
layout.top = screen.h * 0.075;
layout.bottom = screen.h - screen.h * 0.075;

# Monospace only, sized in three steps so text stays legible from 1366x768 up
# to 2560x1440 without ever being rasterised at one size and scaled to another.
#
# Three weights, not one. The HUD text is the attacker's readout and stays
# subordinate to the subject; the two story beats are the sequence talking to
# the viewer and are set large and bold. Neither ever competes with the skull
# for the centre of the frame — they sit above and below it.
ui_font = "Monospace 16";
story_font = "Monospace Bold 26";
watch_font = "Monospace Bold 32";
if (scale > 0.72) {
  ui_font = "Monospace 21";
  story_font = "Monospace Bold 34";
  watch_font = "Monospace Bold 42";
}
if (scale > 1.15) {
  ui_font = "Monospace 27";
  story_font = "Monospace Bold 44";
  watch_font = "Monospace Bold 54";
}

State.tick = 0;
State.elapsed = 0;
State.progress = 0;
State.quitting = 0;
State.jitter = 0;
State.jitter_prev = 0;

# Canonical timeline in seconds. docs/TIMING.md mirrors this table exactly;
# change both together.
#
# The arc is an intrusion, not a title card: something traces the machine,
# finds a subject, confirms it, gets caught, loses the link, and is still
# there afterwards. The watcher is deliberately held back to the very end so
# the reveal lands as a reversal rather than as an introduction.
# The opening runs fast on purpose. A trace that takes its time is a loading
# screen; one that finds you in a second is an intrusion. Everything the
# opening gave up is spent at the other end, where the watcher holds.
T.black_out    = 0.22;   # complete black before anything is drawn
T.acquire_in   = 0.22;   # the system wakes: grid, telemetry, packet noise
T.acquire_out  = 1.30;
T.trace_in     = 0.32;   # TRACE INITIATED
T.trace_out    = 0.92;
T.scan_in      = 0.50;   # reticle sweeps looking for a subject
T.scan_out     = 1.50;
T.subject_in   = 0.95;   # SUBJECT ACQUIRED
T.subject_out  = 1.55;
T.skull_in     = 1.10;   # gore skull reconstructs from fragments
T.skull_formed = 2.20;
T.link_in      = 1.90;   # VISUAL LINK ESTABLISHED
T.link_out     = 3.10;
T.lock_in      = 3.30;   # brackets tighten, TARGET LOCKED
T.lock_out     = 4.60;
T.sway_in      = 4.00;   # dangling eyeball begins a heavy sway
T.sway_full    = 5.00;
T.jaw_in       = 4.60;   # jaw opens with slow weight
T.jaw_out      = 5.90;
T.match_in     = 4.75;   # BIOMETRIC MATCH
T.match_out    = 5.55;
T.ignite_in    = 5.30;   # red ignition, empty socket only, hard on/off
T.corrupt_in   = 5.90;   # the intrusion is noticed and the link degrades
T.corrupt_out  = 6.70;
T.breach_in    = 5.95;   # CONNECTION COMPROMISED
T.breach_out   = 6.55;
T.lost_in      = 6.60;   # SIGNAL LOST
T.lost_out     = 7.20;
T.mosh_in      = 7.00;   # data-mosh, packet loss, disintegration
T.mosh_out     = 7.70;
T.watch_in     = 7.55;   # the watcher resolves out of the static
T.watch_text   = 7.95;   # BIG BROTHER IS WATCHING
T.watch_out    = 9.70;   # ...and holds. This is the beat that matters.
T.black_in     = 9.70;   # total black for the display-manager handoff
T.end          = 10.00;

fun clamp(value, low, high) {
  if (value < low) return low;
  if (value > high) return high;
  return value;
}

fun abs(value) {
  if (value < 0) return 0 - value;
  return value;
}

# Linear 0..1 across [a, b], clamped outside it.
fun ramp(now, a, b) {
  if (b <= a) {
    if (now < a) return 0;
    return 1;
  }
  return clamp((now - a) / (b - a), 0, 1);
}

# 1 inside [a, b), 0 outside. Used for the hard on/off states.
fun hold(now, a, b) {
  if (now >= a && now < b) return 1;
  return 0;
}

# Smoothstep, for anything that should feel weighted rather than mechanical.
fun ease(value) {
  local.v;
  v = clamp(value, 0, 1);
  return v * v * (3 - 2 * v);
}

fun pulse(start, attack, sustain, release, now) {
  if (now < start) return 0;
  if (now < start + attack) return (now - start) / attack;
  if (now < start + attack + sustain) return 1;
  if (now < start + attack + sustain + release)
    return 1 - ((now - start - attack - sustain) / release);
  return 0;
}

# Deterministic integer hash. Small multipliers keep every intermediate value
# inside the exact range of a double, so the same seed always produces the
# same corruption on every machine.
fun hash(n) {
  local.h;
  h = ((n + Config.random_seed) * 71) % 991;
  h = (h * 113 + n * 29) % 1009;
  if (h < 0) return 0 - h;
  return h;
}

fun hash01(n) {
  return hash(n) / 1009;
}

# -1, 0 or 1, for deterministic horizontal displacement.
fun hash_sign(n) {
  return (hash(n) % 3) - 1;
}

fun flicker(n, salt) {
  if ((hash(n * 7 + salt) % 19) < 3) return 0.22;
  return 1;
}

# Position and reveal in one call. Sprites below the visibility threshold are
# only hidden, never repositioned, so off-screen systems cost nothing.
fun place(sprite, x, y, opacity) {
  if (opacity <= 0.004) {
    sprite.SetOpacity(0);
    return;
  }
  sprite.SetX(x);
  sprite.SetY(y);
  sprite.SetOpacity(clamp(opacity, 0, 1));
}

# ==== 20-smoke.script ====
# Background atmosphere. Two counter-drifting layers, always behind the
# subject and always below 25% opacity so the skull is never obscured.

Smoke.enabled = 1;
if (Config.smoke_density <= 0) Smoke.enabled = 0;

if (Smoke.enabled) {
  # The artwork fades to zero alpha well inside its own edges, so it can stay
  # smaller than the screen without showing a boundary.
  Smoke.size = Math.Int(1000 * scale);
  Smoke.a_image = Image("effects/smoke.png").Scale(Smoke.size, Smoke.size);
  Smoke.b_image = Image("effects/smoke-02.png").Scale(Smoke.size, Smoke.size);
  Smoke.a = Sprite(Smoke.a_image);
  Smoke.b = Sprite(Smoke.b_image);
  Smoke.a.SetZ(-80);
  Smoke.b.SetZ(-79);
  Smoke.a.SetOpacity(0);
  Smoke.b.SetOpacity(0);
  Smoke.home_x = screen.cx - Smoke.size / 2;
  Smoke.home_y = screen.cy - Smoke.size / 2;
}

# Hard ceiling regardless of configuration: atmosphere must stay atmosphere.
Smoke.ceiling = 0.24;

fun Smoke.Update(t) {
  if (Smoke.enabled == 0) return;
  local.density;
  local.level;
  density = Config.smoke_density;
  if (density > Smoke.ceiling) density = Smoke.ceiling;
  # Present from the moment the system wakes until the feed collapses. The
  # watcher at the end gets a clean black field to itself.
  level = ramp(t, T.acquire_in, T.skull_in) * density;
  level = level * (1 - ramp(t, T.mosh_in, T.watch_in));
  place(Smoke.a,
        Smoke.home_x + Math.Sin(t * 0.16) * 26 * scale,
        Smoke.home_y + Math.Sin(t * 0.11) * 15 * scale,
        level);
  place(Smoke.b,
        Smoke.home_x - Math.Sin(t * 0.13 + 1.7) * 21 * scale,
        Smoke.home_y - Math.Sin(t * 0.09 + 0.6) * 12 * scale,
        level * 0.62);
}

# ==== 30-skull.script ====
# Hyper-real gore skull using three complete photographic scream states.
#
# Full-frame switching avoids visible crop seams in natural bone and wet
# tissue. The dangling eye remains present in every state; independent sway is
# disabled for this master because no clean black crop corridor exists.

# Dangling-eye column, re-derived from the hyper-real masters. The eyeball now
# sits much closer to the cheek than it did in the flat concept, so the seam
# only just clears bone (peak 87 of 255) and x 428..432 is the one margin that
# is black in all three frames. Kept correct for the opt-in crop path even
# though dangling_eye_enabled defaults to 0.
Skull.SRC = 560;
Skull.EYE_COL = 352;
Skull.BULB_TOP = 352;
Skull.BULB_RIGHT = 432;
Skull.BULB_BOTTOM = 440;
Skull.size = Math.Int(Skull.SRC * scale);
Skull.unit = Skull.size / Skull.SRC;
Skull.ox = Math.Int(screen.cx - Skull.size / 2);
Skull.oy = Math.Int(screen.cy - Skull.size / 2);

fun Skull.U(value) {
  return Math.Int(value * Skull.unit);
}

Skull.frame_0 = Image("skull/scream-00.png").Scale(Skull.size, Skull.size);
Skull.frame_1 = Image("skull/scream-01.png").Scale(Skull.size, Skull.size);
Skull.frame_2 = Image("skull/scream-02.png").Scale(Skull.size, Skull.size);
Skull.sprite = Sprite(Skull.frame_0);
Skull.sprite.SetZ(10);
Skull.sprite.SetOpacity(0);
Skull.frame = 0;
Skull.reveal = 0;
Skull.jaw_offset = 0;
Skull.x = Skull.ox;
Skull.y = Skull.oy;
Skull.gore = 1;

fun Skull.SetFrame(index) {
  if (Skull.frame == index) return;
  Skull.frame = index;
  if (index == 0) Skull.sprite.SetImage(Skull.frame_0);
  if (index == 1) Skull.sprite.SetImage(Skull.frame_1);
  if (index == 2) Skull.sprite.SetImage(Skull.frame_2);
}

fun Skull.Update(t) {
  local.build;
  local.reveal;
  local.unstable;
  local.rise;
  local.frame;
  build = ease(ramp(t, T.skull_in, T.skull_formed));
  reveal = ramp(t, T.skull_in, T.skull_in + 0.22);
  # Fully gone before the watcher resolves: the two never share the screen.
  reveal = reveal * (1 - ramp(t, T.mosh_in, T.watch_in));
  if (t < T.skull_formed) reveal = reveal * flicker(State.tick, 3);
  Skull.reveal = reveal;

  unstable = (1 - build) * 26 * scale;
  if (t > T.corrupt_in) unstable = ramp(t, T.corrupt_in, T.mosh_in) * 20 * scale;
  State.jitter_prev = State.jitter;
  State.jitter = 0;
  if ((hash(State.tick) % 7) < 2) State.jitter = hash_sign(State.tick * 5) * unstable;

  rise = (1 - build) * 22 * scale;
  Skull.x = Skull.ox + State.jitter;
  Skull.y = Skull.oy + rise;

  frame = 0;
  if (t >= T.jaw_in + 0.16) frame = 1;
  if (t >= T.jaw_in + 0.42) frame = 2;
  Skull.SetFrame(frame);

  place(Skull.sprite, Skull.x, Skull.y, reveal);
}

# ==== 35-dangling-eye.script ====
# Dangling eyeball and optic nerve.
#
# The viewer-right socket is the only one holding an eye; the viewer-left
# socket stays empty. The scream frames already carry the eyeball, so this
# module adds the one thing three keyframes cannot: motion independent of the
# jaw. It cuts the x 352..432 / y 352..440 column out of whichever frame is
# currently displayed and re-lays it a few pixels inboard, taking the lower
# optic nerve with it. The upper nerve stays anchored in the socket, so the
# two read as one attached system that flexes where the bulb hangs.
#
# The swing is a deterministic sine pendulum; Plymouth has no physics and does
# not need any here. The tile is never rotated, which is what keeps the iris
# aimed downward through the whole swing.
#
# Travel is inboard only, and clamped. Sliding the opaque tile left uncovers
# x 428..432 of the frame underneath, which is black in all three frames; a
# wider or outward slide would uncover the bulb's own edge and tear it.
#
# OFF BY DEFAULT. In the hyper-real masters the eyeball is nestled against the
# cheek with no black corridor beside it, so the seam clears bone by only a
# few levels and the cut shows at full travel. The three authored frames move
# the eyeball on their own; this is an opt-in for a wider swing, and the swing
# should be kept small if it is turned on.

DanglingEye.on = 0;
if (Config.dangling_eye_enabled && Skull.gore) DanglingEye.on = 1;

if (DanglingEye.on) {
  DanglingEye.dx = Skull.U(Skull.EYE_COL);
  DanglingEye.dy = Skull.U(Skull.BULB_TOP);
  DanglingEye.w = Skull.U(Skull.BULB_RIGHT) - DanglingEye.dx;
  DanglingEye.h = Skull.U(Skull.BULB_BOTTOM) - DanglingEye.dy;

  # One cut per authored frame, so the column always matches the jaw state.
  DanglingEye.cut_0 = Skull.frame_0.Crop(DanglingEye.dx, DanglingEye.dy,
                                         DanglingEye.w, DanglingEye.h);
  DanglingEye.cut_1 = Skull.frame_1.Crop(DanglingEye.dx, DanglingEye.dy,
                                         DanglingEye.w, DanglingEye.h);
  DanglingEye.cut_2 = Skull.frame_2.Crop(DanglingEye.dx, DanglingEye.dy,
                                         DanglingEye.w, DanglingEye.h);
  DanglingEye.sprite = Sprite(DanglingEye.cut_0);
  DanglingEye.sprite.SetZ(13);
  DanglingEye.sprite.SetOpacity(0);
  DanglingEye.frame = 0;

  # Nerve root at master (372, 300), bulb centre at master (382, 408).
  DanglingEye.length = 108 * scale;
  DanglingEye.amplitude = Config.dangling_eye_sway * DanglingEye.length;
  # Hard ceiling in master pixels: past this the slide uncovers artwork.
  DanglingEye.limit = 4 * scale;
  if (DanglingEye.amplitude > DanglingEye.limit)
    DanglingEye.amplitude = DanglingEye.limit;
}

fun DanglingEye.SetFrame(index) {
  if (DanglingEye.frame == index) return;
  DanglingEye.frame = index;
  if (index == 0) DanglingEye.sprite.SetImage(DanglingEye.cut_0);
  if (index == 1) DanglingEye.sprite.SetImage(DanglingEye.cut_1);
  if (index == 2) DanglingEye.sprite.SetImage(DanglingEye.cut_2);
}

fun DanglingEye.Update(t) {
  if (DanglingEye.on == 0) return;
  if (Skull.reveal <= 0.004) {
    DanglingEye.sprite.SetOpacity(0);
    return;
  }
  DanglingEye.SetFrame(Skull.frame);

  local.amp;
  local.phase;
  local.swing;
  local.drag;

  # Almost still at first, then a slow build to a heavy sway that never
  # entirely settles.
  amp = ease(ramp(t, T.sway_in, T.sway_full)) * 0.86;
  amp = amp + ease(ramp(t, T.jaw_in, T.jaw_out)) * 0.14;
  phase = (t - T.sway_in) * Config.dangling_eye_speed * 3.93;

  # (1 - cos)/2 starts at rest and swings inboard and back, so the tile never
  # travels outward past the artwork it is covering.
  swing = 0 - amp * DanglingEye.amplitude * (1 - Math.Cos(phase)) * 0.5;
  # One frame behind the skull's displacement, which is what reads as mass.
  drag = State.jitter_prev * 0.62 - State.jitter;

  place(DanglingEye.sprite,
        Skull.x + DanglingEye.dx + swing + drag,
        Skull.y + DanglingEye.dy,
        Skull.reveal);
}

# ==== 40-eyes.script ====
# Red ignition.
#
# The moment the subject registers the observer. Hard on, hard off, no fade,
# no bloom ramp.
#
# Only the empty viewer-left socket ignites. The viewer-right socket has its
# eye hanging out of it on the optic nerve — there is nothing left in there to
# light up, and lighting it anyway read as a decoration rather than as a
# reaction.
#
# Anchored to the hyper-real master, whose viewer-left socket sits at a
# darkness centroid of (217, 251) and is about 100 px across — wider and lower
# than the flat concept it replaced.
#
# eyes.png carries two glows 112 px apart, centred at (72, 64) and (184, 64).
# Cropping its left half isolates one, which is scaled to 204 px so the bloom
# fills the socket, putting the glow centre at (115, 102) inside the tile.

Eyes.size = Skull.U(204);
Eyes.dx = Skull.U(102);   # 217 - 115
Eyes.dy = Skull.U(149);   # 251 - 102

Eyes.glow_image = Image("skull/eyes.png").Crop(0, 0, 128, 128).Scale(Eyes.size, Eyes.size);
Eyes.core_image = Image("skull/eye-cores.png").Crop(0, 0, 128, 128).Scale(Eyes.size, Eyes.size);
Eyes.glow = Sprite(Eyes.glow_image);
Eyes.core = Sprite(Eyes.core_image);
Eyes.glow.SetZ(20);
Eyes.core.SetZ(21);
Eyes.glow.SetOpacity(0);
Eyes.core.SetOpacity(0);

fun Eyes.Update(t) {
  local.lit;
  lit = hold(t, T.ignite_in, T.ignite_in + Config.eye_duration);
  place(Eyes.glow, Skull.x + Eyes.dx, Skull.y + Eyes.dy, lit * 0.85);
  place(Eyes.core, Skull.x + Eyes.dx, Skull.y + Eyes.dy, lit);
}

# ==== 45-bigbrother.script ====
# The watcher.
#
# One anonymous human eye, held back until the very end. The whole sequence up
# to this point is a system tracing, acquiring and confirming a subject; when
# the link finally dies, the eye resolves out of the static and puts its own
# reticle on the viewer. The reversal is the point: the thing doing the
# watching was never the machine.
#
# It resolves through four preloaded states — corrupted, recognition pass,
# clean, tracked — and never moves. Stillness is what makes it read as
# attention rather than as an animation.

BigBrother.enabled = Config.big_brother_eye_enabled;

if (BigBrother.enabled) {
  # Sized against both axes so it stays a face looking out of a feed rather
  # than a full-screen splash, and leaves the lower band clear for the caption.
  BigBrother.w = screen.w * 0.52;
  if (BigBrother.w > screen.h * 0.74) BigBrother.w = screen.h * 0.74;
  BigBrother.w = Math.Int(BigBrother.w);
  BigBrother.h = Math.Int(BigBrother.w * 576 / 1024);

  # Decoded and scaled once; the refresh callback only swaps between these.
  BigBrother.corrupted = Image("eye/eye-corrupted.png").Scale(BigBrother.w, BigBrother.h);
  BigBrother.harsh = Image("eye/eye-high-contrast.png").Scale(BigBrother.w, BigBrother.h);
  BigBrother.clean = Image("eye/eye-surveillance.png").Scale(BigBrother.w, BigBrother.h);
  BigBrother.tracked = Image("eye/eye-tracked.png").Scale(BigBrother.w, BigBrother.h);

  BigBrother.sprite = Sprite(BigBrother.corrupted);
  # Above the subject and the HUD, below the scanlines and the terminal mask,
  # so the eye comes up through the interference rather than on top of it.
  BigBrother.sprite.SetZ(80);
  BigBrother.sprite.SetOpacity(0);
  BigBrother.state = 0;

  BigBrother.home_x = Math.Int(screen.cx - BigBrother.w / 2);
  BigBrother.home_y = Math.Int(screen.cy - BigBrother.h / 2 - screen.h * 0.06);
}

fun BigBrother.SetState(state) {
  if (BigBrother.state == state) return;
  BigBrother.state = state;
  if (state == 1) BigBrother.sprite.SetImage(BigBrother.corrupted);
  if (state == 2) BigBrother.sprite.SetImage(BigBrother.harsh);
  if (state == 3) BigBrother.sprite.SetImage(BigBrother.clean);
  if (state == 4) BigBrother.sprite.SetImage(BigBrother.tracked);
}

fun BigBrother.Update(t) {
  if (BigBrother.enabled == 0) return;
  if (t < T.watch_in || t >= T.watch_out) {
    BigBrother.sprite.SetOpacity(0);
    return;
  }

  local.state;
  local.level;

  # Offsets from watch_in rather than absolute times, so retiming the sequence
  # cannot leave the resolve stranded behind the beat it belongs to.
  state = 1;
  if (t >= T.watch_in + 0.28) state = 2;
  if (t >= T.watch_in + 0.48) state = 3;
  # The reticle turns around and settles on whoever is reading the screen,
  # and then simply stays there for the rest of the sequence.
  if (t >= T.watch_in + 0.90) state = 4;
  BigBrother.SetState(state);

  level = ramp(t, T.watch_in, T.watch_in + 0.13);
  # Unstable only while it is still coming out of the interference.
  if (t < T.watch_in + 0.48) level = level * flicker(State.tick, 5);

  place(BigBrother.sprite, BigBrother.home_x, BigBrother.home_y, level);
}

# ==== 50-hud.script ====
# Surveillance HUD.
#
# Tracking furniture and short-lived state text, playing the beats of an
# intrusion: trace, sweep, acquire, confirm, lock, breach. Everything is small,
# white, monospace and subordinate to the subject — the interface is the
# attacker's, not the theme's, and it never becomes the thing you look at.
#
# Panels anchor to screen fractions rather than to a fixed 1920x1080 box, so
# nothing walks off the edge of a 1366x768 or a portrait panel. Every label
# image and every bracket size is rendered once at load time; the refresh
# callback only swaps between preloaded images and moves sprites.

Hud.on = Config.hud_enabled;

if (Hud.on) {
  Hud.grid_image = Image("hud/monitoring-grid.png").Scale(Skull.U(900), Skull.U(900));
  # Four preloaded sizes: the frame closes in discrete steps instead of
  # rescaling an image inside the refresh callback.
  Hud.bracket_sweep = Image("hud/brackets.png").Scale(Skull.U(880), Skull.U(880));
  Hud.bracket_wide = Image("hud/brackets.png").Scale(Skull.U(760), Skull.U(760));
  Hud.bracket_mid = Image("hud/brackets.png").Scale(Skull.U(660), Skull.U(660));
  Hud.bracket_near = Image("hud/brackets.png").Scale(Skull.U(575), Skull.U(575));
  Hud.bracket_lock = Image("hud/tracking-brackets-tight.png").Scale(Skull.U(495), Skull.U(495));
  Hud.crosshair_image = Image("hud/crosshair.png").Scale(Skull.U(250), Skull.U(250));
  Hud.lock_image = Image("hud/target-lock.png").Scale(Skull.U(300), Skull.U(300));
  Hud.rec_image = Image("hud/rec-indicator.png").Scale(Skull.U(150), Skull.U(44));
  Hud.node_image = Image("hud/node-marker.png").Scale(Skull.U(110), Skull.U(110));
  Hud.telemetry_image = Image("hud/telemetry-panel.png").Scale(Skull.U(420), Skull.U(180));
  Hud.status_image = Image("hud/status-panel.png").Scale(Skull.U(420), Skull.U(224));
  Hud.error_image = Image("hud/error-rate.png").Scale(Skull.U(360), Skull.U(112));
  Hud.frame_image = Image("hud/frame-counter.png").Scale(Skull.U(280), Skull.U(64));
  Hud.packet_image = Image("hud/packet-indicators.png").Scale(Skull.U(320), Skull.U(52));

  Hud.bars_0 = Image("hud/signal-bars-0.png").Scale(Skull.U(180), Skull.U(48));
  Hud.bars_1 = Image("hud/signal-bars-1.png").Scale(Skull.U(180), Skull.U(48));
  Hud.bars_2 = Image("hud/signal-bars-2.png").Scale(Skull.U(180), Skull.U(48));
  Hud.bars_3 = Image("hud/signal-bars-3.png").Scale(Skull.U(180), Skull.U(48));
  Hud.bars_4 = Image("hud/signal-bars-4.png").Scale(Skull.U(180), Skull.U(48));
  Hud.bars_5 = Image("hud/signal-bars-5.png").Scale(Skull.U(180), Skull.U(48));

  Hud.text_trace = Image.Text("TRACE INITIATED", 0.86, 0.86, 0.86, 1, ui_font);
  Hud.text_subject = Image.Text("SUBJECT ACQUIRED", 0.86, 0.86, 0.86, 1, ui_font);
  Hud.text_link = Image.Text("VISUAL LINK ESTABLISHED", 0.86, 0.86, 0.86, 1, ui_font);
  Hud.text_lock = Image.Text("TARGET LOCKED", 0.86, 0.86, 0.86, 1, ui_font);
  Hud.text_match = Image.Text("BIOMETRIC MATCH", 0.86, 0.86, 0.86, 1, ui_font);
  Hud.text_breach = Image.Text("CONNECTION COMPROMISED", 0.86, 0.86, 0.86, 1, ui_font);

  Hud.grid = Sprite(Hud.grid_image);
  Hud.brackets = Sprite(Hud.bracket_sweep);
  Hud.crosshair = Sprite(Hud.crosshair_image);
  Hud.lock = Sprite(Hud.lock_image);
  Hud.bars = Sprite(Hud.bars_1);
  Hud.rec = Sprite(Hud.rec_image);
  Hud.node = Sprite(Hud.node_image);
  Hud.telemetry = Sprite(Hud.telemetry_image);
  Hud.status = Sprite(Hud.status_image);
  Hud.error = Sprite(Hud.error_image);
  Hud.frame = Sprite(Hud.frame_image);
  Hud.packets = Sprite(Hud.packet_image);
  Hud.label = Sprite(Hud.text_trace);

  Hud.grid.SetZ(28);
  Hud.brackets.SetZ(30);
  Hud.crosshair.SetZ(31);
  Hud.lock.SetZ(31);
  Hud.bars.SetZ(32);
  Hud.rec.SetZ(32);
  Hud.node.SetZ(32);
  Hud.telemetry.SetZ(32);
  Hud.status.SetZ(32);
  Hud.error.SetZ(32);
  Hud.frame.SetZ(32);
  Hud.packets.SetZ(32);
  Hud.label.SetZ(33);

  Hud.grid.SetOpacity(0);
  Hud.brackets.SetOpacity(0);
  Hud.crosshair.SetOpacity(0);
  Hud.lock.SetOpacity(0);
  Hud.bars.SetOpacity(0);
  Hud.rec.SetOpacity(0);
  Hud.node.SetOpacity(0);
  Hud.telemetry.SetOpacity(0);
  Hud.status.SetOpacity(0);
  Hud.error.SetOpacity(0);
  Hud.frame.SetOpacity(0);
  Hud.packets.SetOpacity(0);
  Hud.label.SetOpacity(0);

  Hud.bracket_state = 0;
  Hud.bars_state = 1;
  Hud.label_state = 0;
  Hud.label_w = Hud.text_trace.GetWidth();
}

fun Hud.SetBrackets(state) {
  if (Hud.bracket_state == state) return;
  Hud.bracket_state = state;
  if (state == 1) Hud.brackets.SetImage(Hud.bracket_sweep);
  if (state == 2) Hud.brackets.SetImage(Hud.bracket_wide);
  if (state == 3) Hud.brackets.SetImage(Hud.bracket_mid);
  if (state == 4) Hud.brackets.SetImage(Hud.bracket_near);
  if (state == 5) Hud.brackets.SetImage(Hud.bracket_lock);
}

fun Hud.BracketSize(state) {
  if (state == 1) return Skull.U(880);
  if (state == 2) return Skull.U(760);
  if (state == 3) return Skull.U(660);
  if (state == 4) return Skull.U(575);
  return Skull.U(495);
}

fun Hud.SetBars(level) {
  if (Hud.bars_state == level) return;
  Hud.bars_state = level;
  if (level == 0) Hud.bars.SetImage(Hud.bars_0);
  if (level == 1) Hud.bars.SetImage(Hud.bars_1);
  if (level == 2) Hud.bars.SetImage(Hud.bars_2);
  if (level == 3) Hud.bars.SetImage(Hud.bars_3);
  if (level == 4) Hud.bars.SetImage(Hud.bars_4);
  if (level == 5) Hud.bars.SetImage(Hud.bars_5);
}

fun Hud.SetLabel(state) {
  if (Hud.label_state == state) return;
  Hud.label_state = state;
  if (state == 1) {
    Hud.label.SetImage(Hud.text_trace);
    Hud.label_w = Hud.text_trace.GetWidth();
  }
  if (state == 2) {
    Hud.label.SetImage(Hud.text_subject);
    Hud.label_w = Hud.text_subject.GetWidth();
  }
  if (state == 3) {
    Hud.label.SetImage(Hud.text_link);
    Hud.label_w = Hud.text_link.GetWidth();
  }
  if (state == 4) {
    Hud.label.SetImage(Hud.text_lock);
    Hud.label_w = Hud.text_lock.GetWidth();
  }
  if (state == 5) {
    Hud.label.SetImage(Hud.text_match);
    Hud.label_w = Hud.text_match.GetWidth();
  }
  if (state == 6) {
    Hud.label.SetImage(Hud.text_breach);
    Hud.label_w = Hud.text_breach.GetWidth();
  }
}

fun Hud.Update(t) {
  if (Hud.on == 0) return;
  local.live;
  local.state;
  local.size;
  local.frame_show;
  local.cross;
  local.cross_x;
  local.sweep;
  local.step;
  local.lock_show;
  local.level;
  local.label;

  # Global HUD presence: up with the trace, and torn down when the link dies.
  # None of it survives into the watcher's frame — by then the attacker's
  # interface is gone and only the eye is left.
  live = ramp(t, T.acquire_in, T.acquire_in + 0.12);
  live = live * (1 - ramp(t, T.lost_in, T.mosh_in));
  if (t > T.corrupt_in) live = live * flicker(State.tick, 7);

  place(Hud.grid, screen.cx - Skull.U(450), screen.cy - Skull.U(450),
        live * 0.08);

  # Tracking frame: sweeping wide during the trace, closing through the lock.
  state = 1;
  if (t >= T.subject_in) state = 2;
  if (t >= T.link_in) state = 3;
  if (t >= T.lock_in) state = 4;
  if (t >= T.lock_in + 0.55) state = 5;
  Hud.SetBrackets(state);
  size = Hud.BracketSize(state);
  frame_show = ramp(t, T.subject_in - 0.35, T.subject_in - 0.20);
  frame_show = frame_show * (1 - ramp(t, T.corrupt_in, T.corrupt_in + 0.4));
  place(Hud.brackets, screen.cx - size / 2 + State.jitter * 0.3,
        screen.cy - size / 2, live * frame_show * 0.7);

  # Reticle: sweeps the field looking for something, then settles on what it
  # found. The sweep is quantised so it steps like a machine rather than
  # gliding like a cursor.
  cross = 0;
  cross_x = screen.cx;
  if (t < T.skull_in) {
    cross = ramp(t, T.scan_in, T.scan_in + 0.12);
    sweep = ramp(t, T.scan_in, T.subject_in);
    step = Math.Int(sweep * 7) / 7;
    cross_x = screen.cx + (step - 0.5) * screen.w * 0.54;
  } else {
    cross = ramp(t, T.lock_in, T.lock_in + 0.10)
          * (1 - ramp(t, T.lock_out, T.lock_out + 0.25));
  }
  place(Hud.crosshair, cross_x - Skull.U(125), screen.cy - Skull.U(125),
        live * cross * 0.32);
  lock_show = ramp(t, T.lock_in + 0.55, T.lock_in + 0.64);
  lock_show = lock_show * (1 - ramp(t, T.lock_out, T.lock_out + 0.22));
  place(Hud.lock, screen.cx - Skull.U(150), screen.cy - Skull.U(150),
        live * lock_show * 0.62);

  # Telemetry. The signal climbs while the intrusion is working and collapses
  # once it is noticed.
  level = 1;
  if (t >= T.scan_in) level = 3;
  if (t >= T.skull_formed) level = 5;
  if (t >= T.corrupt_in) level = 3;
  if (t >= T.lost_in) level = 1;
  if (t >= T.mosh_in) level = 0;
  Hud.SetBars(level);
  place(Hud.bars, layout.right - Skull.U(180), layout.top, live * 0.78);
  place(Hud.packets, layout.right - Skull.U(320), layout.top + Skull.U(70),
        live * ramp(t, T.trace_in, T.trace_in + 0.2) * 0.6);
  place(Hud.rec, layout.left, layout.top,
        live * flicker(State.tick, 13) * 0.9);
  place(Hud.frame, layout.left, layout.bottom - Skull.U(64), live * 0.55);
  place(Hud.node, screen.cx + Skull.U(300), screen.cy - screen.h * 0.16,
        live * ramp(t, T.scan_in, T.scan_in + 0.15)
             * (1 - ramp(t, T.skull_in, T.skull_in + 0.3)) * 0.6);
  place(Hud.telemetry, layout.left, screen.cy - Skull.U(90),
        live * ramp(t, T.link_in, T.link_in + 0.15)
             * (1 - ramp(t, T.corrupt_in, T.corrupt_in + 0.3)) * 0.58);
  place(Hud.status, layout.right - Skull.U(420), screen.cy - Skull.U(112),
        live * ramp(t, T.lock_in, T.lock_in + 0.15)
             * (1 - ramp(t, T.corrupt_out, T.lost_in)) * 0.52);
  place(Hud.error, layout.right - Skull.U(360), layout.bottom - Skull.U(112),
        live * ramp(t, T.corrupt_in, T.corrupt_in + 0.1) * 0.72);

  # State text: small, centred under the subject, short-lived.
  label = 0;
  if (t >= T.trace_in && t < T.trace_out) label = 1;
  if (t >= T.subject_in && t < T.subject_out) label = 2;
  if (t >= T.link_in && t < T.link_out) label = 3;
  if (t >= T.lock_in && t < T.lock_out) label = 4;
  if (t >= T.match_in && t < T.match_out) label = 5;
  if (t >= T.breach_in && t < T.breach_out) label = 6;
  if (label == 0) {
    Hud.label.SetOpacity(0);
    return;
  }
  Hud.SetLabel(label);
  place(Hud.label, screen.cx - Hud.label_w / 2, screen.cy + Skull.U(345),
        live * 0.92);
}

# ==== 60-glitch.script ====
# Signal corruption.
#
# Every burst is a deterministic function of the 30 fps tick and the configured
# seed, so two machines with the same config corrupt identically. All images
# are decoded and scaled once here; the refresh callback only swaps between
# preloaded pairs, moves sprites, and sets opacity.
#
# Two classes of layer, for a reason:
#
#   washes  cover everything they are drawn over: noise, static and the
#           terminal mask. A wash with a hard rectangular edge reads as a box
#           sitting on the picture rather than as damage to the signal, so
#           these have to reach the edges of the screen. They do it as a 2x2
#           grid of sprites sharing one quarter-screen image, which costs a
#           quarter of the memory of a screen-sized layer and repeats
#           invisibly because the artwork is random.
#   marks   are sparse: tears, packet strips, compression blocks, channel
#           split, data-mosh. These stay a fixed field centred on the subject.
#           There is no edge to see, and damage concentrated on the subject is
#           what the sequence is about.
#
# Scanlines are a third case: periodic in y and uniform in x, so one
# screen-wide strip stacked down the display is exact and nearly free.

Glitch.field = Math.Int(512 * scale * 1.4);
Glitch.fx = Math.Int(screen.cx - Glitch.field / 2);
Glitch.fy = Math.Int(screen.cy - Glitch.field / 2);

Glitch.wash_w = Math.Int(screen.w / 2) + 1;
Glitch.wash_h = Math.Int(screen.h / 2) + 1;
Glitch.wash_count = 4;

Glitch.noise_image = Image("effects/noise.png").Scale(Glitch.wash_w, Glitch.wash_h);
Glitch.static_image = Image("effects/static-burst.png").Scale(Glitch.wash_w, Glitch.wash_h);
Glitch.mask_image = Image("effects/signal-loss.png").Scale(Glitch.wash_w, Glitch.wash_h);

i = 0;
while (i < Glitch.wash_count) {
  wx = (i % 2) * Glitch.wash_w;
  wy = Math.Int(i / 2) * Glitch.wash_h;

  Glitch.noise[i] = Sprite(Glitch.noise_image);
  Glitch.noise[i].SetZ(60);
  Glitch.noise[i].SetX(wx);
  Glitch.noise[i].SetY(wy);
  Glitch.noise[i].SetOpacity(0);

  Glitch.static[i] = Sprite(Glitch.static_image);
  Glitch.static[i].SetZ(71);
  Glitch.static[i].SetX(wx);
  Glitch.static[i].SetY(wy);
  Glitch.static[i].SetOpacity(0);

  Glitch.mask[i] = Sprite(Glitch.mask_image);
  Glitch.mask[i].SetZ(95);
  Glitch.mask[i].SetX(wx);
  Glitch.mask[i].SetY(wy);
  Glitch.mask[i].SetOpacity(0);

  i = i + 1;
}

Glitch.tear_image = Image("effects/horizontal-tear.png").Scale(Glitch.field, Glitch.field);
Glitch.offset_image = Image("effects/image-offset.png").Scale(Glitch.field, Glitch.field);
Glitch.packet_image = Image("effects/packet-loss.png").Scale(Glitch.field, Glitch.field);
Glitch.mosh_image = Image("effects/data-mosh.png").Scale(Glitch.field, Glitch.field);
Glitch.red_image = Image("effects/rgb-split-red.png").Scale(Glitch.field, Glitch.field);
Glitch.white_image = Image("effects/rgb-split-white.png").Scale(Glitch.field, Glitch.field);
Glitch.block_a = Image("effects/compression-blocks.png").Scale(Glitch.field, Glitch.field);
Glitch.block_b = Image("effects/compression-blocks-02.png").Scale(Glitch.field, Glitch.field);

Glitch.tear = Sprite(Glitch.tear_image);
Glitch.offset = Sprite(Glitch.offset_image);
Glitch.packet = Sprite(Glitch.packet_image);
Glitch.mosh = Sprite(Glitch.mosh_image);
Glitch.red = Sprite(Glitch.red_image);
Glitch.white = Sprite(Glitch.white_image);
Glitch.block = Sprite(Glitch.block_a);

Glitch.block.SetZ(63);
Glitch.packet.SetZ(64);
Glitch.tear.SetZ(66);
Glitch.offset.SetZ(67);
Glitch.red.SetZ(68);
Glitch.white.SetZ(69);
Glitch.mosh.SetZ(70);

Glitch.tear.SetOpacity(0);
Glitch.offset.SetOpacity(0);
Glitch.packet.SetOpacity(0);
Glitch.mosh.SetOpacity(0);
Glitch.red.SetOpacity(0);
Glitch.white.SetOpacity(0);
Glitch.block.SetOpacity(0);
Glitch.block_state = 0;

# Scanlines: one screen-wide strip repeated down the display. Scaling the 8x8
# tile to the full screen would stretch two hairlines into two huge bands.
Glitch.scan_on = 0;
if (Config.film_grain > 0) {
  Glitch.scan_on = 1;
  Glitch.strip_h = Math.Int(24 * scale);
  if (Glitch.strip_h < 8) Glitch.strip_h = 8;
  Glitch.scan_image = Image("effects/scanlines.png").Scale(screen.w, Glitch.strip_h);
  Glitch.scan_count = Math.Int(screen.h / Glitch.strip_h) + 1;
  i = 0;
  while (i < Glitch.scan_count) {
    Glitch.scan[i] = Sprite(Glitch.scan_image);
    Glitch.scan[i].SetZ(90);
    Glitch.scan[i].SetX(0);
    Glitch.scan[i].SetY(i * Glitch.strip_h);
    Glitch.scan[i].SetOpacity(0);
    i = i + 1;
  }
}

# Lens falloff is radial, so it is the one layer that genuinely needs a
# screen-sized image. Set vignette_opacity=0 to skip it entirely.
Glitch.vignette_on = 0;
if (Config.vignette_opacity > 0) {
  Glitch.vignette_on = 1;
  Glitch.vignette = Sprite(Image("effects/vignette.png").Scale(screen.w, screen.h));
  Glitch.vignette.SetZ(89);
  Glitch.vignette.SetOpacity(0);
}

# Written out rather than shared, so nothing depends on how the interpreter
# passes an indexed object into a function. Each one skips its loop when the
# level has not moved, which is most frames for the static and the mask.
Glitch.noise_level = 0;
Glitch.static_level = 0;
Glitch.mask_level = 0;
Glitch.scan_level = 0;

fun Glitch.WashNoise(level) {
  local.value;
  local.i;
  value = clamp(level, 0, 1);
  if (Glitch.noise_level == value) return;
  Glitch.noise_level = value;
  i = 0;
  while (i < Glitch.wash_count) {
    Glitch.noise[i].SetOpacity(value);
    i = i + 1;
  }
}

fun Glitch.WashStatic(level) {
  local.value;
  local.i;
  value = clamp(level, 0, 1);
  if (Glitch.static_level == value) return;
  Glitch.static_level = value;
  i = 0;
  while (i < Glitch.wash_count) {
    Glitch.static[i].SetOpacity(value);
    i = i + 1;
  }
}

fun Glitch.WashMask(level) {
  local.value;
  local.i;
  value = clamp(level, 0, 1);
  if (Glitch.mask_level == value) return;
  Glitch.mask_level = value;
  i = 0;
  while (i < Glitch.wash_count) {
    Glitch.mask[i].SetOpacity(value);
    i = i + 1;
  }
}

fun Glitch.SetBlock(state) {
  if (Glitch.block_state == state) return;
  Glitch.block_state = state;
  if (state == 1) Glitch.block.SetImage(Glitch.block_a);
  if (state == 2) Glitch.block.SetImage(Glitch.block_b);
}

# The scanline stack is the largest sprite list in the theme and its level is
# constant for most of the sequence, so the loop only runs on a change.
fun Glitch.Scanlines(level) {
  if (Glitch.scan_on == 0) return;
  local.value;
  local.i;
  value = clamp(level, 0, 1);
  if (Glitch.scan_level == value) return;
  Glitch.scan_level = value;
  i = 0;
  while (i < Glitch.scan_count) {
    Glitch.scan[i].SetOpacity(value);
    i = i + 1;
  }
}

fun Glitch.Hide() {
  Glitch.WashNoise(0);
  Glitch.WashStatic(0);
  Glitch.WashMask(0);
  Glitch.Scanlines(0);
  Glitch.tear.SetOpacity(0);
  Glitch.offset.SetOpacity(0);
  Glitch.packet.SetOpacity(0);
  Glitch.mosh.SetOpacity(0);
  Glitch.red.SetOpacity(0);
  Glitch.white.SetOpacity(0);
  Glitch.block.SetOpacity(0);
  if (Glitch.vignette_on) Glitch.vignette.SetOpacity(0);
}

fun Glitch.Update(t) {
  if (t >= T.black_in) {
    Glitch.Hide();
    return;
  }

  local.g;
  local.tick;
  local.slide;
  local.acquire;
  local.sweep;
  local.rebuild;
  local.decay;
  local.collapse;
  local.hit;
  local.strong;
  local.grain;
  local.burst;
  local.split;

  g = Config.glitch_intensity;
  tick = State.tick;
  # Marks slide; the washes never do, because sliding a tiled layer would drag
  # an uncovered strip in behind it.
  slide = hash_sign(tick * 3) * 16 * scale;

  # The system wakes: packet noise and acquisition marks.
  acquire = ramp(t, T.acquire_in, T.acquire_in + 0.06)
          * (1 - ramp(t, T.acquire_out - 0.25, T.acquire_out));
  # The reticle sweeps: light tearing as the feed is pulled around.
  sweep = ramp(t, T.scan_in, T.scan_in + 0.08)
        * (1 - ramp(t, T.scan_out - 0.30, T.scan_out));
  # The skull arrives as unstable fragments.
  rebuild = ramp(t, T.skull_in, T.skull_in + 0.06)
          * (1 - ramp(t, T.skull_formed - 0.35, T.skull_formed));
  # The intrusion is noticed and the link degrades. Both of these have to fall
  # away again before the watcher resolves, or the corruption they drive would
  # sit on top of the last beat for a second and a half.
  decay = ramp(t, T.corrupt_in, T.corrupt_out)
        * (1 - ramp(t, T.lost_out, T.mosh_out));
  # Data-mosh, packet loss, disintegration.
  collapse = ramp(t, T.mosh_in, T.mosh_in + 0.12)
           * (1 - ramp(t, T.watch_in, T.watch_in + 0.30));

  # A single-frame hit that never stops entirely, so the feed always feels
  # live rather than paused.
  hit = 0;
  if ((hash(tick) % 23) < 2) hit = 1;
  strong = 0;
  if ((hash(tick * 5) % 7) < 3) strong = 1;

  # The noise wash doubles as the constant film grain: barely there while the
  # trace is clean, climbing with every failure, and holding a low floor under
  # the watcher so the last beat still feels like a live feed.
  grain = Config.film_grain * 0.5 * ramp(t, T.acquire_in, T.scan_in);
  if (t >= T.watch_in) grain = Config.film_grain * 0.8;
  burst = acquire * 0.16 + rebuild * 0.30 + decay * 0.55 + collapse * 0.45;
  Glitch.WashNoise(grain + (burst * 0.62 + hit * 0.12) * g);
  Glitch.WashStatic((decay * 0.30 + collapse * 0.52) * hit * g);

  Glitch.SetBlock(1 + (hash(tick * 7) % 2));
  place(Glitch.block, Glitch.fx, Glitch.fy,
        (rebuild * 0.5 + decay * 0.45) * strong * g);
  place(Glitch.packet, Glitch.fx + slide, Glitch.fy,
        (acquire * 0.55 + collapse * 0.7) * strong * g);
  place(Glitch.tear, Glitch.fx + slide * 1.6, Glitch.fy,
        (sweep * 0.55 + decay * 0.55) * strong * g);
  place(Glitch.offset, Glitch.fx - slide * 1.2, Glitch.fy,
        (sweep * 0.5 + decay * 0.4) * hit * g);

  # Palette-safe channel split: red one way, white the other.
  split = (decay * 0.55 + collapse * 0.45) * hit * g;
  place(Glitch.red, Glitch.fx + 9 * scale, Glitch.fy, split * 0.8);
  place(Glitch.white, Glitch.fx - 6 * scale, Glitch.fy, split * 0.6);

  place(Glitch.mosh, Glitch.fx + slide * 0.8, Glitch.fy,
        ramp(t, T.mosh_in, T.mosh_in + 0.1)
        * (1 - ramp(t, T.watch_in, T.watch_in + 0.25)) * g * 0.85);

  # Scanlines and lens falloff run all the way through the watcher: the last
  # beat is still a monitor, not a photograph.
  Glitch.Scanlines(Config.film_grain * (1 - ramp(t, T.black_in - 0.15, T.black_in)));
  if (Glitch.vignette_on)
    place(Glitch.vignette, 0, 0,
          Config.vignette_opacity * ramp(t, T.acquire_in, T.scan_in)
          * (1 - ramp(t, T.black_in - 0.20, T.black_in)));

  # The terminal mask wipes the disintegrating subject, then pulls back so the
  # watcher resolves up through it rather than being cut to.
  Glitch.WashMask(ramp(t, T.mosh_in + 0.10, T.mosh_out - 0.20)
                  * (1 - ramp(t, T.watch_in + 0.05, T.watch_in + 0.40)));
}

# ==== 70-timing.script ====
# Clock, orchestration, and Plymouth lifecycle.
#
# The clock counts refresh ticks rather than reading wall time, so the
# sequence is frame-exact and reproducible. Config.refresh_rate must match the
# rate Plymouth actually drives the script plugin at; SetRefreshRate is
# requested below, and the value can be corrected in config/theme.conf if a
# particular Plymouth build ignores it.

Plymouth.SetRefreshRate(Config.refresh_rate);

# The two beats that are the story rather than the interface, so they are
# independent of hud_enabled.
#
# Both are letter-spaced. Monospace already sets an even rhythm; opening it up
# further slows the eye down and stops the words reading as a status line. It
# is the cheapest way to make short text feel deliberate rather than logged,
# and Plymouth gives no tracking control otherwise.
Failure.text = Image.Text("S I G N A L   L O S T", 0.92, 0.92, 0.92, 1, story_font);
Failure.label = Sprite(Failure.text);
Failure.label.SetZ(98);
Failure.label.SetOpacity(0);
Failure.w = Failure.text.GetWidth();

Watching.text = Image.Text("B I G   B R O T H E R   I S   W A T C H I N G",
                           1.0, 1.0, 1.0, 1, watch_font);
Watching.label = Sprite(Watching.text);
Watching.label.SetZ(99);
Watching.label.SetOpacity(0);
Watching.w = Watching.text.GetWidth();
Watching.y = Math.Int(layout.bottom - Watching.text.GetHeight());

# Mode 0 renders the sequence. Any other mode means Plymouth needs the screen
# for a prompt, so the sequence gets out of the way immediately.
Mode.current = 0;
Mode.prompt = Sprite();
Mode.prompt.SetZ(120);
Mode.prompt.SetOpacity(0);
Mode.message = Sprite();
Mode.message.SetZ(120);
Mode.message.SetOpacity(0);

State.finished = 0;
State.blanked = 0;

fun Curruption.Draw(t) {
  local.lost;
  local.watching;

  Smoke.Update(t);
  BigBrother.Update(t);
  Skull.Update(t);
  DanglingEye.Update(t);
  Eyes.Update(t);
  Hud.Update(t);
  Glitch.Update(t);

  lost = hold(t, T.lost_in, T.lost_out) * flicker(State.tick, 11);
  place(Failure.label, screen.cx - Failure.w / 2, screen.cy + Skull.U(345), lost);

  # Steady, not flickering: everything else on screen has failed, and this has
  # not. It materialises slowly rather than cutting in, and is the last thing
  # on the screen before black.
  watching = ramp(t, T.watch_text, T.watch_text + 0.35)
           * (1 - ramp(t, T.watch_out - 0.08, T.watch_out));
  place(Watching.label, screen.cx - Watching.w / 2, Watching.y, watching);
}

# Every system already collapses to nothing past the end of the timeline, so
# one update well past it is a complete, single-path blank. The time is taken
# from the timeline rather than from animation_duration, which a user is free
# to set short.
fun Curruption.Blank() {
  Curruption.Draw(T.end + 10);
  Failure.label.SetOpacity(0);
  Watching.label.SetOpacity(0);
}

fun Curruption.Refresh() {
  local.t;
  State.tick = State.tick + 1;

  if (Mode.current != 0) {
    if (State.blanked == 0) {
      Curruption.Blank();
      State.blanked = 1;
    }
    return;
  }

  if (State.finished) return;

  State.elapsed = State.tick / Config.refresh_rate * Config.animation_speed;
  t = State.elapsed;

  if (t >= Config.animation_duration) {
    # Final frame is total black so the display-manager handoff cannot flash.
    Curruption.Blank();
    State.finished = 1;
    return;
  }

  Curruption.Draw(t);
}

# --- Plymouth lifecycle -----------------------------------------------------
# None of these block boot progress; the sequence never waits on them and
# never holds the splash open.

fun Curruption.BootProgress(duration, progress) {
  State.progress = progress;
}

fun Curruption.Bullets(count) {
  local.text;
  local.n;
  local.i;
  text = "";
  n = count;
  if (n > 32) n = 32;
  i = 0;
  while (i < n) {
    text = text + "*";
    i = i + 1;
  }
  return text;
}

# Disk unlock and any other prompt must be readable, so the sequence yields
# the screen rather than competing with it.
fun Curruption.DisplayPassword(prompt, bullets) {
  local.label;
  local.image;
  Mode.current = 1;
  State.blanked = 0;
  label = prompt;
  if (label == "") label = "ENTER PASSPHRASE";
  image = Image.Text(label + "   " + Curruption.Bullets(bullets),
                     0.9, 0.9, 0.9, 1, ui_font);
  Mode.prompt.SetImage(image);
  Mode.prompt.SetX(screen.cx - image.GetWidth() / 2);
  Mode.prompt.SetY(screen.cy - image.GetHeight() / 2);
  Mode.prompt.SetOpacity(1);
}

fun Curruption.DisplayQuestion(prompt, entry) {
  local.image;
  Mode.current = 2;
  State.blanked = 0;
  image = Image.Text(prompt + "   " + entry, 0.9, 0.9, 0.9, 1, ui_font);
  Mode.prompt.SetImage(image);
  Mode.prompt.SetX(screen.cx - image.GetWidth() / 2);
  Mode.prompt.SetY(screen.cy - image.GetHeight() / 2);
  Mode.prompt.SetOpacity(1);
}

fun Curruption.DisplayNormal() {
  Mode.current = 0;
  Mode.prompt.SetOpacity(0);
  # The sequence does not restart; it stays where it ended.
  if (State.finished) Curruption.Blank();
}

fun Curruption.Message(text) {
  local.image;
  image = Image.Text(text, 0.72, 0.72, 0.72, 1, ui_font);
  Mode.message.SetImage(image);
  Mode.message.SetX(screen.cx - image.GetWidth() / 2);
  Mode.message.SetY(layout.bottom - image.GetHeight());
  Mode.message.SetOpacity(1);
}

fun Curruption.HideMessage(text) {
  Mode.message.SetOpacity(0);
}

fun Curruption.Quit() {
  State.quitting = 1;
  Mode.prompt.SetOpacity(0);
  Mode.message.SetOpacity(0);
  Curruption.Blank();
}

Plymouth.SetRefreshFunction(Curruption.Refresh);
Plymouth.SetBootProgressFunction(Curruption.BootProgress);
Plymouth.SetDisplayPasswordFunction(Curruption.DisplayPassword);
Plymouth.SetDisplayQuestionFunction(Curruption.DisplayQuestion);
Plymouth.SetDisplayNormalFunction(Curruption.DisplayNormal);
Plymouth.SetDisplayMessageFunction(Curruption.Message);
Plymouth.SetHideMessageFunction(Curruption.HideMessage);
Plymouth.SetQuitFunction(Curruption.Quit);
